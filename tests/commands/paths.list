ln -s ../a.txt d/up; cat d/up; ln -s ../../a.txt d/e/up2; cat d/e/up2; cat d/e/../../a.txt; cat d/e/../e/../../a.txt
cat ./a.txt; cat .//a.txt; cat d/../a.txt; cat d/./e/../../a.txt; cat a.txt/ 2>&1 | sed 's/^.*: //'; cat a.txt/. 2>&1 | sed 's/^.*: //'; cat nothing/../a.txt 2>&1 | sed 's/^.*: //'
