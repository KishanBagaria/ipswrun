# Processes that talk to each other: sockets with names, pipes, signals and waits, by nc and by perl's own calls. See run.sh.
( nc -lU s.sock > got & ); sleep 0.5; echo over the socket | nc -U s.sock; sleep 0.3; cat got; ls -l s.sock | cut -c1
( echo from the listener | nc -lU s.sock & ); sleep 0.5; nc -U s.sock < /dev/null; test -S s.sock && echo a socket
nc -U nothing.sock < /dev/null 2>&1 | sed 's/^.*: //'; touch plain; nc -U plain < /dev/null 2>&1 | sed 's/^.*: //'
perl -e 'socketpair(A, B, 1, 1, 0) or die; if (fork) { close B; syswrite(A, "ping\n"); shutdown(A, 1); print scalar <A>; wait } else { close A; $_ = <B>; syswrite(B, "pong after $_"); exit 0 }'
perl -e 'socketpair(A, B, 1, 2, 0) or die $!; send(A, "one", 0); send(A, "two", 0); recv(B, $x, 100, 0); recv(B, $y, 100, 0); print "$x $y\n"'
perl -MSocket -e 'socket(S, PF_UNIX, SOCK_STREAM, 0); bind(S, sockaddr_un("p.sock")) or die $!; listen(S, 5); if (!fork) { socket(C, PF_UNIX, SOCK_STREAM, 0); connect(C, sockaddr_un("p.sock")) or die $!; syswrite(C, "hello server\n"); print scalar <C>; exit } accept(N, S); $l = <N>; syswrite(N, "got: $l"); close N; wait; print -S "p.sock" ? "bound\n" : "gone\n"'
perl -MSocket -e 'socket(S, PF_UNIX, SOCK_STREAM, 0); bind(S, sockaddr_un("p.sock")) or die; print bind(S, sockaddr_un("q.sock")) ? "twice" : "once: $!", "\n"; socket(T, PF_UNIX, SOCK_STREAM, 0); print bind(T, sockaddr_un("p.sock")) ? "shared" : "taken: $!", "\n"'
perl -MSocket -e 'socket(C, PF_UNIX, SOCK_STREAM, 0); print connect(C, sockaddr_un("none.sock")) ? "connected" : "$!", "\n"; socket(S, PF_UNIX, SOCK_STREAM, 0); bind(S, sockaddr_un("nl.sock")); socket(D, PF_UNIX, SOCK_STREAM, 0); print connect(D, sockaddr_un("nl.sock")) ? "connected" : "$!", "\n"'
perl -MSocket -e 'socket(S, PF_UNIX, SOCK_DGRAM, 0); bind(S, sockaddr_un("d.sock")) or die $!; socket(C, PF_UNIX, SOCK_DGRAM, 0); send(C, "datagram", 0, sockaddr_un("d.sock")) or die $!; recv(S, $m, 100, 0); print "$m\n"'
perl -MSocket -e 'socketpair(A, B, PF_UNIX, SOCK_STREAM, 0); print getsockopt(A, SOL_SOCKET, SO_TYPE) eq pack("i", SOCK_STREAM) ? "stream" : "other", "\n"; setsockopt(A, SOL_SOCKET, SO_SNDBUF, pack("i", 4096)) or print "$!\n"; print unpack("i", getsockopt(A, SOL_SOCKET, SO_SNDBUF)), "\n"'
perl -MSocket -e 'socketpair(A, B, PF_UNIX, SOCK_STREAM, 0); close B; $SIG{PIPE} = sub { print "sigpipe\n" }; print defined(syswrite(A, "x")) ? "written" : "$!", "\n"; print sysread(A, $b, 10), " read at the end\n"'
perl -e 'pipe(R, W); if (fork) { close W; while (<R>) { $n++ } wait; print "$n lines, child left with ", $? >> 8, "\n" } else { close R; print W "line $_\n" for 1 .. 2000; exit 3 }'
perl -e 'pipe(R, W); $w = syswrite(W, "x" x 100000); print "$w\n"' & sleep 1; kill $! 2>/dev/null; wait $! 2>/dev/null; echo $?
perl -e 'use Fcntl; pipe(R, W); fcntl(W, F_SETFL, O_NONBLOCK); $t = 0; while (defined($n = syswrite(W, "x" x 4096))) { $t += $n } print "$t bytes, then $!\n"'
perl -e 'pipe(R, W); vec($r, fileno(R), 1) = 1; print scalar(select($x = $r, undef, undef, 0.1)), " ready\n"; syswrite(W, "x"); print scalar(select($x = $r, undef, undef, 0.1)), " ready\n"; close W; sysread(R, $b, 9); print scalar(select($x = $r, undef, undef, 0.1)), " ready at the end\n"'
perl -e 'pipe(R, W); close R; $SIG{PIPE} = "IGNORE"; print defined(syswrite(W, "x")) ? "written" : "$!", "\n"; $SIG{PIPE} = "DEFAULT"; syswrite(W, "x"); print "not reached\n"'; echo $?
perl -e '$SIG{ALRM} = sub { print "alarm\n" }; alarm 1; $n = sleep 5; print "slept short\n" if $n < 5'
perl -e '$SIG{USR1} = sub { $got++ }; $p = fork; if (!$p) { kill "USR1", getppid for 1 .. 3; exit } waitpid($p, 0); select(undef, undef, undef, 0.2); print $got >= 1 ? "signalled\n" : "nothing\n"'
perl -e '$p = fork; if (!$p) { sleep 10; exit } kill "TERM", $p; waitpid($p, 0); print "signal ", $? & 127, "\n"; $q = fork; if (!$q) { exit 9 } waitpid($q, 0); print "status ", $? >> 8, "\n"; print waitpid(-1, 0), " ", $!, "\n"'
perl -e 'use POSIX ":sys_wait_h"; $p = fork; if (!$p) { sleep 1; exit 2 } print waitpid($p, WNOHANG), "\n"; print waitpid($p, 0) == $p ? "reaped" : "not", " ", $? >> 8, "\n"'
perl -e 'for $i (1 .. 5) { $k{fork || exit $i} = $i } while (($p = wait) > 0) { $s += $? >> 8 } print "$s\n"'
perl -e '$p = fork; if (!$p) { setpgrp(0, 0); sleep 10 } select(undef, undef, undef, 0.3); print getpgrp($p) == $p ? "own group\n" : "not yet\n"; kill "KILL", -$p; waitpid($p, 0); print $? & 127, "\n"'
perl -e 'use POSIX; $p = fork; if (!$p) { POSIX::setsid(); print getpgrp() == $$ ? "leads\n" : "follows\n"; exit } waitpid($p, 0); print $? >> 8, " and the parent leads none\n" if getpgrp() != $$ || 1'
perl -e 'use Fcntl ":flock"; open(F, ">", "lk"); flock(F, LOCK_EX) or die; if (!fork) { open(G, ">", "lk"); print flock(G, LOCK_EX | LOCK_NB) ? "got it" : "held: $!", "\n"; exit } wait; flock(F, LOCK_UN); open(G, ">", "lk"); print flock(G, LOCK_EX | LOCK_NB) ? "free\n" : "still held\n"'
perl -e 'use Fcntl; open(F, "+>", "rl"); print F "x" x 100; $l = pack("q q i s s", 0, 10, 0, F_WRLCK, 0); fcntl(F, F_SETLK, $l) or die $!; if (!fork) { open(G, "+<", "rl"); print fcntl(G, F_SETLK, $l) ? "got it" : "held: $!", "\n"; $m = pack("q q i s s", 50, 10, 0, F_WRLCK, 0); print fcntl(G, F_SETLK, $m) ? "another part is free\n" : "$!\n"; exit } wait'
perl -e 'open(F, ">", "t"); print F "abc"; close F; open(F, "+<", "t"); seek(F, 1, 0); print F "X"; seek(F, 0, 0); print scalar <F>, "\n"; truncate(F, 2); print -s "t", "\n"; seek(F, 10, 0); print F "z"; close F; print -s "t", "\n"'
perl -e 'open(F, ">", "t"); close F; @s = stat "t"; utime(1000000000, 1000000001, "t"); @t = stat "t"; print "$t[8] $t[9]\n"; chmod 0640, "t"; printf "%o\n", (stat "t")[2] & 07777; rename "t", "u"; print -e "t" ? "still" : "moved", "\n"; unlink "u"; print -e "u" ? "there" : "gone", "\n"'
perl -e 'mkdir "pd", 0750; opendir(D, "."); @n = grep { !/^\./ } readdir D; print scalar(@n), "\n"; rewinddir D; print scalar(grep { $_ eq "pd" } readdir D), "\n"; rmdir "pd"; print -d "pd" ? "there" : "gone", "\n"'
perl -e 'symlink "a.txt", "pl"; print readlink("pl"), " ", -l "pl" ? "link" : "plain", " ", (lstat "pl")[7], "\n"; link "a.txt", "ph"; print((stat "a.txt")[3], "\n"); print((stat "ph")[1] == (stat "a.txt")[1] ? "one file\n" : "two\n")'
perl -e 'umask 027; open(F, ">", "um"); printf "%o\n", (stat "um")[2] & 0777; printf "%o\n", umask; print "$<" == "$>" ? "one user\n" : "two\n"; print "$(" =~ /^\d+/ ? "groups\n" : "none\n"'
perl -e 'print $$ == getppid() ? "same" : "child of another", "\n"; print getpgrp() > 0 ? "in a group\n" : "none\n"; print((getpwuid($<))[7] eq $ENV{HOME} ? "home agrees\n" : "home differs\n"); print scalar(@{[getgrgid($()]}) > 0 ? "group named\n" : "group not named\n"'
perl -e '$0 = "renamed"; print `ps -p $$ -o comm=` =~ /perl|renamed/ ? "listed\n" : "not listed\n"; print kill(0, $$), kill(0, 1) ? "" : " not init", "\n"'
perl -e 'print join(" ", map { sprintf "%s=%d", $_, eval "POSIX::$_()" // -1 } ()), "times: ", scalar(@{[times]}), "\n"; ($u, $s) = times; print $u >= 0 && $s >= 0 ? "counted\n" : "not\n"; print time > 1700000000 ? "after 2023\n" : "before\n"'
perl -MTime::HiRes=time,sleep,usleep -e '$a = time; sleep 0.25; $d = time - $a; print $d >= 0.25 && $d < 5 ? "a quarter second\n" : "off: $d\n"; $a = time; usleep 1000; print time - $a < 1 ? "a moment\n" : "long\n"'
perl -MPOSIX -e 'print POSIX::sysconf(_SC_PAGESIZE) > 0 ? "pages\n" : "none\n"; print POSIX::sysconf(_SC_OPEN_MAX) >= 256 ? "descriptors\n" : "few\n"; print POSIX::ttyname(0) // "no terminal", "\n"; print POSIX::isatty(1) ? "a terminal\n" : "not a terminal\n"'
perl -MPOSIX -e '$fd = POSIX::open("po", O_CREAT | O_WRONLY, 0600); POSIX::write($fd, "abcdef", 6); $d = POSIX::dup($fd); POSIX::lseek($d, 2, SEEK_SET); POSIX::write($fd, "XY", 2); POSIX::close($fd); POSIX::close($d); open(F, "po"); print scalar <F>, "\n"; POSIX::dup2(1, 9); print POSIX::write(9, "through nine\n", 13) == 13 ? "" : "failed\n"'
perl -MPOSIX -e 'POSIX::mkfifo("pf", 0600) or die $!; if (!fork) { open(W, ">", "pf"); print W "through the pipe\n"; exit } open(R, "<", "pf"); print scalar <R>; wait; print -p "pf" ? "a pipe\n" : "not\n"'
perl -MPOSIX -e 'POSIX::mkfifo("pf", 0600); use Fcntl; print sysopen(W, "pf", O_WRONLY | O_NONBLOCK) ? "opened" : "$!", "\n"; sysopen(R, "pf", O_RDONLY | O_NONBLOCK) or die $!; print defined(sysread(R, $b, 10)) ? "read nothing" : "$!", "\n"; sysopen(W, "pf", O_WRONLY | O_NONBLOCK) or die $!; syswrite(W, "now"); sysread(R, $b, 10); print "$b\n"'
perl -e 'open(P, "-|", "echo", "from", "a", "child") or die; print scalar <P>; close P; print $? >> 8, "\n"; open(Q, "|-", "tr a-z A-Z") or die; print Q "to a child\n"; close Q; open(E, "-|", "sh -c \"exit 5\""); close E; print $? >> 8, "\n"'
perl -e 'print system("true") >> 8, system("false") >> 8, system("sh", "-c", "exit 7") >> 8, "\n"; print system("/nowhere/prog") == -1 ? "not run: $!\n" : "ran\n"; $o = `echo back; echo err >&2`; print $o; exec "echo", "replaced" or print "not replaced\n"' 2>&1
perl -e '%ENV = (ONLY => "this", PATH => "/usr/bin:/bin"); print `env | sort | cut -d= -f1 | tr "\n" " "`, "\n"; delete $ENV{ONLY}; print `sh -c "echo \\\${ONLY-unset}"`'
perl -e 'open(F, "<", "/usr/share/dict/words"); $n++ while <F>; print "$n\n"; seek(F, -8, 2); read(F, $t, 8); print length($t), "\n"; print tell(F) == -s F ? "at the end\n" : "elsewhere\n"; binmode F; print eof(F) ? "eof\n" : "more\n"'
perl -e 'open(F, ">", "big"); seek(F, 5_000_000_000, 0); print F "x"; close F; print -s "big", "\n"; @s = stat "big"; print $s[12] * 512 < 1_000_000 ? "sparse\n" : "filled\n"; unlink "big"'
perl -e 'opendir(D, "/dev/fd"); @f = sort { $a <=> $b } grep { /^\d+$/ } readdir D; print "@f[0..2]\n"; open(N, ">", "/dev/null"); print N "gone"; print -c "/dev/null" ? "a device\n" : "not\n"; open(Z, "<", "/dev/zero"); read(Z, $z, 4); print unpack("H*", $z), "\n"'
perl -e 'use IO::Select; pipe(R1, W1); pipe(R2, W2); $s = IO::Select->new(\*R1, \*R2); syswrite(W2, "x"); @r = $s->can_read(0.2); print scalar(@r), " ", $r[0] == \*R2 ? "the second" : "the first", "\n"; syswrite(W1, "y"); print scalar($s->can_read(0.2)), "\n"; print scalar(IO::Select->new(\*W1)->can_write(0.2)), "\n"'
perl -MIO::Socket::UNIX -e '$l = IO::Socket::UNIX->new(Local => "io.sock", Listen => 5) or die $!; if (!fork) { $c = IO::Socket::UNIX->new(Peer => "io.sock") or die $!; print $c "line one\nline two\n"; $c->shutdown(1); print <$c>; exit } $n = $l->accept; @in = <$n>; print $n scalar(@in), " lines taken\n"; close $n; wait; print $l->hostpath, "\n"'
perl -MIO::Handle -e 'pipe(R, W); W->autoflush(1); R->blocking(0); print defined(R->sysread($b, 5)) ? "data" : "$!", "\n"; print W "abc"; R->blocking(1); R->sysread($b, 5); print "$b\n"; print fileno(R) < fileno(W) ? "in order\n" : "not\n"'
perl -MPOSIX -e 'print((POSIX::uname())[0], "\n")'
